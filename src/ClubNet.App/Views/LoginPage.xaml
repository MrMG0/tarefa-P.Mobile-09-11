<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClubNet.App.Views.LoginPage"
             Title="ClubNet"
             BackgroundColor="#0f172a">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">

            <!-- Logo Header -->
            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Label Text="CLUBNET"
                       TextColor="#38bdf8"
                       FontSize="34"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
                <Label Text="Aplicativo Oficial do Associado"
                       TextColor="#94a3b8"
                       FontSize="14"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Card de Login / Cadastro -->
            <Border BackgroundColor="#1e293b"
                    Stroke="#334155"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="24">

                <VerticalStackLayout Spacing="16">

                    <!-- Seletor de Modo: Entrar vs Quero me Associar -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button x:Name="BtnAbaLogin"
                                Text="Entrar"
                                BackgroundColor="#0284c7"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                Clicked="OnAbaLoginClicked" />
                        <Button x:Name="BtnAbaCadastro"
                                Grid.Column="1"
                                Text="Quero me Associar"
                                BackgroundColor="#334155"
                                TextColor="#94a3b8"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                Clicked="OnAbaCadastroClicked" />
                    </Grid>

                    <!-- PAINEL LOGIN -->
                    <VerticalStackLayout x:Name="PanelLogin" Spacing="14">
                        <Label Text="Acesse com suas credenciais" TextColor="#cbd5e1" FontSize="13" />

                        <Entry x:Name="TxtLoginEmail"
                               Placeholder="E-mail do Associado"
                               PlaceholderColor="#64748b"
                               TextColor="White"
                               BackgroundColor="#0f172a"
                               Keyboard="Email" />

                        <Entry x:Name="TxtLoginSenha"
                               Placeholder="Senha"
                               PlaceholderColor="#64748b"
                               TextColor="White"
                               BackgroundColor="#0f172a"
                               IsPassword="True" />

                        <Button Text="Acessar Minha Conta"
                                BackgroundColor="#0284c7"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                HeightRequest="48"
                                Clicked="OnBtnLoginClicked" />

                        <Label Text="Atalhos Rápidos para Demonstração:" TextColor="#64748b" FontSize="11" HorizontalOptions="Center" Margin="0,10,0,0"/>
                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Button Text="Carlos (Aprovado)"
                                    BackgroundColor="#1e3a8a"
                                    TextColor="#93c5fd"
                                    FontSize="11"
                                    Clicked="OnQuickLoginCarlos" />
                            <Button Text="Marcos (Pendente)"
                                    BackgroundColor="#78350f"
                                    TextColor="#fde68a"
                                    FontSize="11"
                                    Clicked="OnQuickLoginMarcos" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- PAINEL CADASTRO / SOLICITAÇÃO DE ASSOCIAÇÃO -->
                    <VerticalStackLayout x:Name="PanelCadastro" Spacing="12" IsVisible="False">
                        <Label Text="Solicitação de Ingresso ao Clube" TextColor="#38bdf8" FontSize="14" FontAttributes="Bold" />

                        <Picker x:Name="PickerClubes"
                                Title="Selecione o Clube pretendido"
                                TextColor="White"
                                TitleColor="#64748b"
                                BackgroundColor="#0f172a"
                                ItemDisplayBinding="{Binding Nome}" />

                        <Picker x:Name="PickerTipoAssociado"
                                Title="Categoria pretendida"
                                TextColor="White"
                                TitleColor="#64748b"
                                BackgroundColor="#0f172a" />

                        <Entry x:Name="TxtCadNome"
                               Placeholder="Nome Completo *"
                               PlaceholderColor="#64748b"
                               TextColor="White"
                               BackgroundColor="#0f172a" />

                        <Entry x:Name="TxtCadCpf"
                               Placeholder="CPF *"
                               PlaceholderColor="#64748b"
                               TextColor="White"
                               BackgroundColor="#0f172a"
                               Keyboard="Numeric" />

                        <Entry x:Name="TxtCadTelefone"
                               Placeholder="Telefone / Celular"
                               PlaceholderColor="#64748b"
                               TextColor="White"
                               BackgroundColor="#0f172a"
                               Keyboard="Telephone" />

                        <Entry x:Name="TxtCadEmail"
                               Placeholder="E-mail *"
                               PlaceholderColor="#64748b"
                               TextColor="White"
                               BackgroundColor="#0f172a"
                               Keyboard="Email" />

                        <Entry x:Name="TxtCadSenha"
                               Placeholder="Senha de Acesso *"
                               PlaceholderColor="#64748b"
                               TextColor="White"
                               BackgroundColor="#0f172a"
                               IsPassword="True" />

                        <Entry x:Name="TxtCadInteresses"
                               Placeholder="Interesses (ex: Pesca, Churrasco, Natação)"
                               PlaceholderColor="#64748b"
                               TextColor="White"
                               BackgroundColor="#0f172a" />

                        <Button Text="Enviar Solicitação de Ingresso"
                                BackgroundColor="#059669"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                HeightRequest="48"
                                Clicked="OnBtnCadastrarClicked" />
                    </VerticalStackLayout>

                    <!-- Indicador de Carregamento -->
                    <ActivityIndicator x:Name="LoadingSpinner" IsRunning="False" IsVisible="False" Color="#38bdf8" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
