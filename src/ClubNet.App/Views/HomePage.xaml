<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClubNet.App.Views.HomePage"
             Title="ClubNet"
             BackgroundColor="#f8fafc">

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="20">

            <!-- Card de Identificação do Clube e Associado -->
            <Border BackgroundColor="#0f172a"
                    Stroke="#1e293b"
                    StrokeShape="RoundRectangle 16"
                    Padding="20">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="CLUBE VINCULADO" TextColor="#38bdf8" FontSize="11" FontAttributes="Bold" />
                    </HorizontalStackLayout>

                    <Label x:Name="LblNomeClube"
                           Text="Carregando Clube..."
                           TextColor="White"
                           FontSize="20"
                           FontAttributes="Bold" />

                    <HorizontalStackLayout Spacing="10" Margin="0,4,0,0">
                        <Label Text="Associado:" TextColor="#94a3b8" FontSize="13" />
                        <Label x:Name="LblNomeAssociado" Text="..." TextColor="#f1f5f9" FontSize="13" FontAttributes="Bold" />
                    </HorizontalStackLayout>

                    <Border x:Name="BadgeSituacao"
                            BackgroundColor="#1e3a8a"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 6"
                            Padding="8,4"
                            HorizontalOptions="Start">
                        <Label x:Name="LblSituacao" Text="ATIVO" TextColor="#93c5fd" FontSize="11" FontAttributes="Bold" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Seção de Ações Rápidas -->
            <Label Text="Serviços e Atalhos Rápidos" TextColor="#334155" FontSize="16" FontAttributes="Bold" Margin="4,8,0,0" />

            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="12">
                <!-- Atalho Mensalidades -->
                <Border BackgroundColor="White" Stroke="#e2e8f0" StrokeShape="RoundRectangle 12" Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavMensalidades" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="💲" FontSize="28" />
                        <Label Text="Mensalidades" TextColor="#0f172a" FontSize="14" FontAttributes="Bold" />
                        <Label Text="Consultar e pagar" TextColor="#64748b" FontSize="11" />
                    </VerticalStackLayout>
                </Border>

                <!-- Atalho Reservas -->
                <Border Grid.Column="1" BackgroundColor="White" Stroke="#e2e8f0" StrokeShape="RoundRectangle 12" Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavReservas" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="📅" FontSize="28" />
                        <Label Text="Reservar Espaço" TextColor="#0f172a" FontSize="14" FontAttributes="Bold" />
                        <Label Text="Salões e quiosques" TextColor="#64748b" FontSize="11" />
                    </VerticalStackLayout>
                </Border>

                <!-- Atalho Eventos -->
                <Border Grid.Row="1" BackgroundColor="White" Stroke="#e2e8f0" StrokeShape="RoundRectangle 12" Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavEventos" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="🎉" FontSize="28" />
                        <Label Text="Eventos do Clube" TextColor="#0f172a" FontSize="14" FontAttributes="Bold" />
                        <Label Text="Programação ativa" TextColor="#64748b" FontSize="11" />
                    </VerticalStackLayout>
                </Border>

                <!-- Atalho Atendimento -->
                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="White" Stroke="#e2e8f0" StrokeShape="RoundRectangle 12" Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavAtendimento" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="💬" FontSize="28" />
                        <Label Text="Fale com o Clube" TextColor="#0f172a" FontSize="14" FontAttributes="Bold" />
                        <Label Text="Pedidos e ouvidoria" TextColor="#64748b" FontSize="11" />
                    </VerticalStackLayout>
                </Border>

                <!-- Atalho Meu Perfil -->
                <Border Grid.Row="2" BackgroundColor="White" Stroke="#e2e8f0" StrokeShape="RoundRectangle 12" Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavPerfil" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="👤" FontSize="28" />
                        <Label Text="Meu Perfil" TextColor="#0f172a" FontSize="14" FontAttributes="Bold" />
                        <Label Text="Dados e dependentes" TextColor="#64748b" FontSize="11" />
                    </VerticalStackLayout>
                </Border>

                <!-- Botão Sair -->
                <Border Grid.Row="2" Grid.Column="1" BackgroundColor="#fee2e2" Stroke="#fecaca" StrokeShape="RoundRectangle 12" Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLogoutClicked" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="🚪" FontSize="28" />
                        <Label Text="Sair do App" TextColor="#991b1b" FontSize="14" FontAttributes="Bold" />
                        <Label Text="Trocar de usuário" TextColor="#b91c1c" FontSize="11" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
