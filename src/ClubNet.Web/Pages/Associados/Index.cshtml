@page
@model ClubNet.Web.Pages.Associados.IndexModel
@{
    ViewData["Title"] = "Gestão de Associados & Dependentes";
}

<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" asp-for="Busca" class="form-control" placeholder="Buscar por nome, CPF ou e-mail..." />
                </div>
            </div>
            <div class="col-md-4">
                <select asp-for="Situacao" class="form-select">
                    <option value="">Todas as Situações</option>
                    <option value="PENDENTE">Pendentes de Aprovação</option>
                    <option value="APROVADO">Aprovados / Ativos</option>
                    <option value="REJEITADO">Rejeitados</option>
                    <option value="INATIVO">Inativos</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 fw-semibold">
                    <i class="bi bi-filter"></i> Filtrar
                </button>
                <a asp-page="/Associados/Index" class="btn btn-outline-secondary">Limpar</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-0">Relação de Associados</h5>
            <small class="text-muted">Total localizado: @Model.Associados.Count registros</small>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nome / Clube</th>
                        <th>CPF</th>
                        <th>Categoria</th>
                        <th>Contato</th>
                        <th>Dependentes</th>
                        <th>Interesses</th>
                        <th>Situação</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Associados.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                Nenhum associado encontrado com os filtros selecionados.
                            </td>
                        </tr>
                    }
                    @foreach (var a in Model.Associados)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@a.Nome</div>
                                <small class="text-muted">@a.NomeClube</small>
                            </td>
                            <td><code>@a.Cpf</code></td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(a.TipoAssociado.Replace("_", " "))
                                </span>
                            </td>
                            <td>
                                <div class="small">@a.Telefone</div>
                                <div class="small text-muted">@a.Email</div>
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalDep_@a.Id">
                                    <i class="bi bi-people me-1"></i> @a.Dependentes.Count
                                </button>
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var item in a.Interesses.Take(2))
                                    {
                                        <span class="badge bg-secondary bg-opacity-25 text-dark" style="font-size: 0.7rem;">@item</span>
                                    }
                                    @if (a.Interesses.Count > 2)
                                    {
                                        <span class="badge bg-secondary" style="font-size: 0.7rem;">+@(a.Interesses.Count - 2)</span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (a.SituacaoCadastro == "APROVADO")
                                {
                                    <span class="badge bg-success">Aprovado</span>
                                }
                                else if (a.SituacaoCadastro == "PENDENTE")
                                {
                                    <span class="badge bg-warning text-dark">Pendente</span>
                                }
                                else if (a.SituacaoCadastro == "REJEITADO")
                                {
                                    <span class="badge bg-danger">Rejeitado</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inativo</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (a.SituacaoCadastro == "PENDENTE")
                                {
                                    <a asp-page-handler="Aprovar" asp-route-id="@a.Id" asp-route-situacao="@Model.Situacao" asp-route-busca="@Model.Busca" class="btn btn-sm btn-success me-1" title="Aprovar Associação">
                                        <i class="bi bi-check-lg"></i> Aprovar
                                    </a>
                                    <a asp-page-handler="Rejeitar" asp-route-id="@a.Id" asp-route-situacao="@Model.Situacao" asp-route-busca="@Model.Busca" class="btn btn-sm btn-outline-danger" title="Rejeitar Solicitação">
                                        <i class="bi bi-x-lg"></i> Rejeitar
                                    </a>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalNovoDep_@a.Id">
                                        <i class="bi bi-person-plus"></i> + Dependente
                                    </button>
                                }
                            </td>
                        </tr>

                        <!-- Modal Dependentes -->
                        <div class="modal fade" id="modalDep_@a.Id" tabindex="-1">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title fw-bold">Dependentes de @a.Nome</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        @if (a.Dependentes.Count == 0)
                                        {
                                            <p class="text-muted">Nenhum dependente cadastrado para este associado.</p>
                                        }
                                        else
                                        {
                                            <ul class="list-group">
                                                @foreach (var d in a.Dependentes)
                                                {
                                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                                        <div>
                                                            <div class="fw-bold">@d.Nome</div>
                                                            <small class="text-muted">Parentesco: @d.Parentesco | CPF: @(d.Cpf ?? "Não informado")</small>
                                                        </div>
                                                        <span class="badge bg-primary rounded-pill">Ativo</span>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Modal Adicionar Dependente -->
                        <div class="modal fade" id="modalNovoDep_@a.Id" tabindex="-1">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <form method="post" asp-page-handler="AddDependente">
                                        <input type="hidden" name="NovoDependente.IdAssociado" value="@a.Id" />
                                        <div class="modal-header">
                                            <h5 class="modal-title fw-bold">Novo Dependente para @a.Nome</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Nome Completo *</label>
                                                <input name="NovoDependente.Nome" class="form-control" required />
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label fw-semibold">Grau de Parentesco</label>
                                                    <input name="NovoDependente.Parentesco" class="form-control" placeholder="Cônjuge, Filho(a)..." />
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label fw-semibold">CPF</label>
                                                    <input name="NovoDependente.Cpf" class="form-control" placeholder="000.000.000-00" />
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Telefone / E-mail</label>
                                                <input name="NovoDependente.Telefone" class="form-control" placeholder="(00) 00000-0000" />
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                                            <button type="submit" class="btn btn-primary fw-bold">Adicionar Dependente</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
