<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ClubNet.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ClubNet.App.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="ClubNet Mobile">

    <TabBar>
        <Tab Title="Início" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate views:HomePage}" />
        </Tab>
        <Tab Title="Mensalidades" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate views:PaymentsPage}" />
        </Tab>
        <Tab Title="Eventos" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate views:EventsPage}" />
        </Tab>
        <Tab Title="Reservas" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate views:ReservationsPage}" />
        </Tab>
        <Tab Title="Atendimento" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate views:RequestsPage}" />
        </Tab>
        <Tab Title="Perfil" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate views:ProfilePage}" />
        </Tab>
    </TabBar>

</Shell>
