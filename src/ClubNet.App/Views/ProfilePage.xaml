<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dtos="clr-namespace:ClubNet.Shared.DTOs;assembly=ClubNet.Shared"
             x:Class="ClubNet.App.Views.ProfilePage"
             Title="Meu Perfil"
             BackgroundColor="#f8fafc">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="20">

            <!-- Card Dados Pessoais -->
            <Border BackgroundColor="White" Stroke="#e2e8f0" StrokeShape="RoundRectangle 14" Padding="18">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="👤" FontSize="26" />
                        <VerticalStackLayout>
                            <Label x:Name="LblNome" Text="..." TextColor="#0f172a" FontSize="17" FontAttributes="Bold" />
                            <Label x:Name="LblCategoria" Text="Associado" TextColor="#0284c7" FontSize="12" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Color="#f1f5f9" Margin="0,4" />

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="10">
                        <Label Text="CPF:" TextColor="#64748b" FontSize="13" />
                        <Label Grid.Column="1" x:Name="LblCpf" Text="..." TextColor="#0f172a" FontSize="13" FontAttributes="Bold" />

                        <Label Grid.Row="1" Text="E-mail:" TextColor="#64748b" FontSize="13" />
                        <Label Grid.Row="1" Grid.Column="1" x:Name="LblEmail" Text="..." TextColor="#0f172a" FontSize="13" />

                        <Label Grid.Row="2" Text="Telefone:" TextColor="#64748b" FontSize="13" />
                        <Label Grid.Row="2" Grid.Column="1" x:Name="LblTelefone" Text="..." TextColor="#0f172a" FontSize="13" />

                        <Label Grid.Row="3" Text="Situação:" TextColor="#64748b" FontSize="13" />
                        <Label Grid.Row="3" Grid.Column="1" x:Name="LblSituacao" Text="..." TextColor="#059669" FontSize="13" FontAttributes="Bold" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Card Interesses -->
            <Border BackgroundColor="White" Stroke="#e2e8f0" StrokeShape="RoundRectangle 14" Padding="18">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Meus Interesses no Clube" TextColor="#0f172a" FontSize="14" FontAttributes="Bold" />
                    <FlexLayout x:Name="FlexInteresses" Wrap="Wrap" JustifyContent="Start">
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Card Dependentes -->
            <Border BackgroundColor="White" Stroke="#e2e8f0" StrokeShape="RoundRectangle 14" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Meus Dependentes Vinculados" TextColor="#0f172a" FontSize="14" FontAttributes="Bold" />

                    <VerticalStackLayout x:Name="StackDependentes" Spacing="8">
                    </VerticalStackLayout>

                    <!-- Formulário Rápido para Adicionar Dependente -->
                    <Border BackgroundColor="#f8fafc" Stroke="#e2e8f0" StrokeShape="RoundRectangle 8" Padding="12">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="+ Adicionar Novo Dependente" TextColor="#0284c7" FontSize="12" FontAttributes="Bold" />
                            <Entry x:Name="TxtDepNome" Placeholder="Nome do Dependente" BackgroundColor="White" />
                            <Grid ColumnDefinitions="*,*">
                                <Entry x:Name="TxtDepParentesco" Placeholder="Parentesco (Filho, Cônjuge...)" BackgroundColor="White" />
                                <Entry Grid.Column="1" x:Name="TxtDepCpf" Placeholder="CPF (opcional)" BackgroundColor="White" />
                            </Grid>
                            <Button Text="Cadastrar Dependente" BackgroundColor="#0284c7" TextColor="White" FontAttributes="Bold" HeightRequest="38" Clicked="OnAddDependenteClicked" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
