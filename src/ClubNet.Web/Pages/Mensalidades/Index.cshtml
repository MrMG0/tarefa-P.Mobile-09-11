@page
@model ClubNet.Web.Pages.Mensalidades.IndexModel
@{
    ViewData["Title"] = "Gestão Financeira & Painel do Tesoureiro";
}

<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <label class="form-label small text-muted mb-1">Filtrar por Situação da Cobrança:</label>
                <div class="btn-group w-100" role="group">
                    <a asp-page="/Mensalidades/Index" class="btn @(string.IsNullOrEmpty(Model.Situacao) ? "btn-primary" : "btn-outline-primary")">Todas</a>
                    <a asp-page="/Mensalidades/Index" asp-route-situacao="ABERTA" class="btn @(Model.Situacao == "ABERTA" ? "btn-warning" : "btn-outline-warning")">Abertas</a>
                    <a asp-page="/Mensalidades/Index" asp-route-situacao="PAGA" class="btn @(Model.Situacao == "PAGA" ? "btn-success" : "btn-outline-success")">Pagas</a>
                    <a asp-page="/Mensalidades/Index" asp-route-situacao="VENCIDA" class="btn @(Model.Situacao == "VENCIDA" ? "btn-danger" : "btn-outline-danger")">Vencidas</a>
                </div>
            </div>
            <div class="col-md-6 text-end align-self-end">
                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalNovaMensalidade">
                    <i class="bi bi-plus-circle me-1"></i> Lançar Nova Mensalidade
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-0">Controle de Mensalidades</h5>
            <small class="text-muted">Total localizado: @Model.Mensalidades.Count faturas</small>
        </div>
        <div class="fw-bold text-primary">
            Total Listado: R$ @(Model.Mensalidades.Sum(m => m.Valor).ToString("N2"))
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Associado</th>
                        <th>Mês Ref.</th>
                        <th>Valor</th>
                        <th>Vencimento</th>
                        <th>Pagamento</th>
                        <th>Situação</th>
                        <th>Observação</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Mensalidades.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                Nenhuma mensalidade encontrada.
                            </td>
                        </tr>
                    }
                    @foreach (var m in Model.Mensalidades)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@m.NomeAssociado</div>
                                <small class="text-muted">@m.NomeClube</small>
                            </td>
                            <td><span class="badge bg-light text-dark border">@m.ReferenciaMes</span></td>
                            <td class="fw-bold">R$ @m.Valor.ToString("N2")</td>
                            <td>@m.DataVencimento.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (m.DataPagamento.HasValue)
                                {
                                    <span class="text-success fw-semibold"><i class="bi bi-check-circle me-1"></i> @m.DataPagamento.Value.ToString("dd/MM/yyyy")</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (m.Situacao == "PAGA")
                                {
                                    <span class="badge bg-success">Paga</span>
                                }
                                else if (m.Situacao == "ABERTA")
                                {
                                    <span class="badge bg-warning text-dark">Em Aberto</span>
                                }
                                else if (m.Situacao == "VENCIDA")
                                {
                                    <span class="badge bg-danger">Vencida</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Cancelada</span>
                                }
                            </td>
                            <td class="small text-muted">@(m.Observacao ?? "-")</td>
                            <td class="text-end">
                                @if (m.Situacao != "PAGA")
                                {
                                    <a asp-page-handler="DarBaixa" asp-route-id="@m.Id" asp-route-situacao="@Model.Situacao" class="btn btn-sm btn-success" title="Registrar Pagamento">
                                        <i class="bi bi-cash-coin me-1"></i> Dar Baixa
                                    </a>
                                }
                                else
                                {
                                    <span class="text-success small fw-semibold"><i class="bi bi-check-all"></i> Quitado</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Nova Mensalidade -->
<div class="modal fade" id="modalNovaMensalidade" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Criar">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Lançar Mensalidade / Cobrança</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Associado *</label>
                        <select asp-for="NovaMensalidade.IdAssociado" class="form-select" required>
                            <option value="">Selecione o associado...</option>
                            @foreach (var a in Model.Associados)
                            {
                                <option value="@a.Id">@a.Nome (@a.Cpf)</option>
                            }
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Mês de Referência *</label>
                            <input asp-for="NovaMensalidade.ReferenciaMes" class="form-control" placeholder="2026-11" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Valor (R$) *</label>
                            <input asp-for="NovaMensalidade.Valor" type="number" step="0.01" class="form-control" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Data de Vencimento *</label>
                        <input asp-for="NovaMensalidade.DataVencimento" type="date" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Observações</label>
                        <input asp-for="NovaMensalidade.Observacao" class="form-control" placeholder="Ex: Mensalidade regular ou taxa de manutenção" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success fw-bold">Gerar Cobrança</button>
                </div>
            </form>
        </div>
    </div>
</div>
